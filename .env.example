# SleizDev environment variables
#
# Copy this file to `.env.local` and fill in your own values, OR just run the
# app as-is — the translation-service's env-loader will inject these same
# documented defaults into process.env if no .env.local is found.
#
# See README-SETUP.md for the full setup guide.

# Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable (anon) key (Project Settings → API → Project API keys → anon public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxx

# Supabase service role key (Project Settings → API → Project API keys → service_role)
# WARNING: This key bypasses Row Level Security. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret__xxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret__xxxxxxxxxxxxxxxxxxxxxxxxx
