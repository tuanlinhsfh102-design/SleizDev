# SleizDev environment variables — DOCUMENTED DEFAULTS
#
# This file is committed to the repo and contains the project's own
# Supabase instance credentials (already public via README-SETUP.md).
# Next.js auto-loads this file on startup, so the app works on first
# install without any user configuration.
#
# To use your OWN Supabase project instead, create a `.env.local` file
# at the project root with your own values — Next.js loads `.env.local`
# AFTER `.env`, so your values will override the defaults here.
#
# A template is provided in `.env.example`.

NEXT_PUBLIC_SUPABASE_URL=https://okeyouuilaldknazzhkx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_kkTBJYylMxU2itNaXSdpsg_8LmNTyH2
SUPABASE_SECRET_KEY=sb_secret__prLx0suhRL4yJtj-k7e2A_gt9Em5Uj
