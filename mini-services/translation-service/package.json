{
  "name": "translation-service",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx/esm --watch src/index.ts",
    "start": "node --import tsx/esm src/index.ts",
    "stt": "python3 scripts/capcut_stt.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "fluent-ffmpeg": "^2.1.3",
    "ffmpeg-static": "^5.3.0",
    "form-data": "^4.0.6",
    "socket.io": "^4.8.3",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/form-data": "^2.2.2",
    "tsx": "^4.19.4"
  },
  "pythonDependencies": {
    "python": ">=3.9",
    "pipPackages": [
      "requests>=2.25.0"
    ],
    "notes": "The vendored CapCut STT bridge (scripts/capcut_stt.py) requires Python 3.9+ and the 'requests' package. Install with: pip3 install requests. Override the Python binary via CAPCUT_PYTHON env var."
  }
}
